# Copy to .env. Never commit the real key.
# The dev server reads these. They are not prefixed with VITE_, so they are not shipped to the browser.

# API key from https://labs.aholo.ai/api-keys (global) or the China labs console.
AHOLO_API_KEY=

# com -> https://api.aholo.ai   cn -> https://api.aholo.cn
# The published Lux3D OpenAPI server entry is the global gateway.
# The TypeScript SDK documents region cn as https://api.aholo.cn.
AHOLO_REGION=com

# Optional full origin override, https only. Paths stay /global/lux3d/v1/...
# AHOLO_API_BASE=https://api.aholo.ai

# G1 or G1-Turbo. Product default is G1.
LUX3D_VERSION=G1

# 10000–300000. Product default is 120000, inside the OpenAPI range.
LUX3D_FACE_COUNT=120000
